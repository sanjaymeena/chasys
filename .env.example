# LLM Provider API Keys
# Uncomment and fill in the providers you want to use

# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=...
# GROQ_API_KEY=...

# Local models (Ollama) — no API key needed, just ensure Ollama is running
# OLLAMA_BASE_URL=http://localhost:11434

# Default provider (used when --provider is not specified)
# DEFAULT_PROVIDER=openai/gpt-4o

# Approval mode: yolo | normal | strict
# APPROVAL_MODE=normal

# Log level: DEBUG | INFO | WARNING | ERROR
# LOG_LEVEL=INFO
